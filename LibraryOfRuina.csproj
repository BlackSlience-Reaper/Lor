<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LibraryOfRuina</RootNamespace>
    <AssemblyName>LibraryOfRuina</AssemblyName>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!-- RitsuLib ships a props file that adds the Runtime/Ui/Shared/Settings reference set
       for the selected game API version (compat/<version>). -->
  <Import Project="$(RitsuLibReferencesProps)" Condition="Exists('$(RitsuLibReferencesProps)')" />

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="ActLikeIt2" HintPath="$(ActLikeIt2Dll)" Private="false" />
    <Reference Include="LibraryOfRuinaLib" HintPath="$(LibraryOfRuinaLibDll)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile-time only ([UsedImplicitly]); leaves no runtime reference. -->
    <PackageReference Include="JetBrains.Annotations" Version="2024.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="build/**" />
    <Compile Remove="dist/**" />
    <Compile Remove="tools/**" />
    <Compile Remove="verification/**" />
    <Compile Remove="loader/**" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LibraryOfRuinaCompatibilityTarget" Value="$(CompatibilityTarget)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The verification suites (verification/) read Debug* accessors and internal state. -->
    <InternalsVisibleTo Include="LibraryOfRuinaVerification" />
  </ItemGroup>

  <ItemGroup>
    <!-- IL hashes of vanilla methods behind skip prefixes and transpilers; see VanillaCopyGuard. -->
    <EmbeddedResource Include="src/infra/patching/vanilla_copy_guard.$(CompatibilityTarget).txt" LogicalName="LibraryOfRuina.vanilla_copy_guard.txt" />
    <!-- Fixed order of auto-discovered patch classes, pool cards, relics and ally providers; see TypeDiscoveryOrder. -->
    <EmbeddedResource Include="src/infra/helpers/type_discovery_order.txt" LogicalName="LibraryOfRuina.type_discovery_order.txt" />
  </ItemGroup>

  <Target Name="ValidateModReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="sts2.dll not found in $(Sts2DataDir). Set GameRefsRoot to the directory holding &lt;version&gt;/game-refs." />
    <Error Condition="!Exists('$(RitsuLibReferencesProps)')" Text="RitsuLib.References.props not found at $(RitsuLibReferencesProps). Unpack RitsuLib 0.6.2 into build/deps/STS2-RitsuLib-0.6.2 or set RitsuLibRoot." />
    <Error Condition="!Exists('$(ActLikeIt2Dll)')" Text="ActLikeIt2.dll not found at $(ActLikeIt2Dll). Build build/ActLikeIt2-src with -p:CompatibilityTarget=$(CompatibilityTarget) first." />
    <Error Condition="!Exists('$(LibraryOfRuinaLibDll)')" Text="LibraryOfRuinaLib.dll not found at $(LibraryOfRuinaLibDll). Run tools/build_lib.sh $(CompatibilityTarget) first." />
    <!-- 清单声明的最低 RitsuLib 是 0.6.2；用更高版本编译可能编进 0.6.2 没有的 API。 -->
    <Warning Condition="Exists('$(RitsuLibRoot)/mod_manifest.json') and !$([System.IO.File]::ReadAllText('$(RitsuLibRoot)/mod_manifest.json').Contains('&quot;version&quot;: &quot;0.6.2&quot;'))" Text="Compiling against RitsuLib at $(RitsuLibRoot), which is not the pinned minimum 0.6.2." />
  </Target>
</Project>
