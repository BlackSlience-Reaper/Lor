<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline snapshot of the built mod assembly: model types, SavedProperty set, Harmony patch
       inventory and mutable static fields. Loads metadata only (MetadataLoadContext); never runs mod
       code or touches Godot, so it is safe to run in CI or a plain terminal. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The installer's own patch-class rule; see the file for why it only reads CustomAttributeData. -->
    <Compile Include="../../src/infra/patching/PatchClassRules.cs" Link="PatchClassRules.cs" />
    <!-- The runtime discovery order, so type_order.txt and patch_order.txt show what LibraryAssemblyTypes returns. -->
    <Compile Include="../../src/infra/helpers/TypeDiscoveryOrder.cs" Link="TypeDiscoveryOrder.cs" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
</Project>
