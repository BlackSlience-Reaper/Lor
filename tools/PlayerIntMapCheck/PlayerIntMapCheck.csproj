<Project Sdk="Microsoft.NET.Sdk">
  <!-- Save-format guard for src/infra/helpers/PlayerIntMapSerializer.cs, run by tools/check.sh: compares it
       byte for byte with the four implementations it replaced (frozen copies in Legacy.cs). No game dependency. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/infra/helpers/PlayerIntMapSerializer.cs" Link="PlayerIntMapSerializer.cs" />
  </ItemGroup>
</Project>
