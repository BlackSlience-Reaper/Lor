<Project Sdk="Microsoft.NET.Sdk">
  <!-- tools/check.sh guard: no reflection by name outside src/interop/. Syntax-only (Roslyn parser, no semantic
       model), so it runs without the game's assemblies. fixtures/ is its regression test and is not compiled. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="fixtures/**" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
  </ItemGroup>
</Project>
