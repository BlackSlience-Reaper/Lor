<Project>
  <!-- Machine-specific paths. Override any of these in local.props (see local.props.example). -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <PropertyGroup>
    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT'">$(MSBuildProgramFiles32)/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == ''">$(HOME)/.local/share/Steam</SteamRoot>

    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(SteamRoot)/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(OS)' == 'Windows_NT'">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(Sts2Dir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    <Sts2ModsDir Condition="'$(Sts2ModsDir)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(Sts2Dir)/SlayTheSpire2.app/Contents/MacOS/mods</Sts2ModsDir>
    <Sts2ModsDir Condition="'$(Sts2ModsDir)' == ''">$(Sts2Dir)/mods</Sts2ModsDir>

    <!-- STS2-RitsuLib Workshop item 3747602295; compat/<version> must match the game API. -->
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">$(SteamRoot)/steamapps/workshop/content/2868840/3747602295</RitsuLibRoot>
    <RitsuLibReferenceTarget Condition="'$(RitsuLibReferenceTarget)' == ''">0.111.0</RitsuLibReferenceTarget>
    <RitsuLibReferencesProps>$(RitsuLibRoot)/RitsuLib.References.props</RitsuLibReferencesProps>

    <ActLikeIt2Dll Condition="'$(ActLikeIt2Dll)' == ''">$(Sts2ModsDir)/ActLikeIt2/ActLikeIt2.dll</ActLikeIt2Dll>
    <LibraryOfRuinaLibDll Condition="'$(LibraryOfRuinaLibDll)' == ''">$(Sts2ModsDir)/LibraryOfRuinaLib/LibraryOfRuinaLib.dll</LibraryOfRuinaLibDll>
  </PropertyGroup>
</Project>
